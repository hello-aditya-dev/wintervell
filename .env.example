# ============================================================================
# WinterVell — Environment Variables Template
# ============================================================================
# This file is a TEMPLATE. Copy it to .env and fill in real values.
# NEVER commit a working .env. Real secrets must never enter version control.
# See docs/setup/environment-variables.md for full reference.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
# Public URL of the WinterVell deployment (no trailing slash).
NEXTAUTH_URL=http://localhost:3000
# Strong random secret for NextAuth (generate with: openssl rand -base64 32).
NEXTAUTH_SECRET=changeme-generate-a-strong-random-secret

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# PRODUCTION: use PostgreSQL. SQLite is for local development only.
# PostgreSQL:  postgresql://user:password@host:5432/wintervell?schema=public
# SQLite (dev): file:./dev.db
DATABASE_URL=postgresql://user:password@localhost:5432/wintervell?schema=public

# ----------------------------------------------------------------------------
# Authentication (NextAuth v4)
# ----------------------------------------------------------------------------
# Comma-separated list of enabled providers, e.g. "credentials,email,google".
NEXTAUTH_PROVIDERS=credentials
# Optional OAuth providers (leave blank if unused).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------------
# SMTP or provider abstraction (Resend, SendGrid). Provider is selected by EMAIL_PROVIDER.
EMAIL_PROVIDER=smtp
EMAIL_FROM="WinterVell <noreply@wintervell.example>"
EMAIL_REPLY_TO="support@wintervell.example"
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Resend
RESEND_API_KEY=
# SendGrid
SENDGRID_API_KEY=

# ----------------------------------------------------------------------------
# AI providers
# ----------------------------------------------------------------------------
# Selected provider: "mock" | "openai" | "anthropic" | "openai-compatible".
# Use "mock" for development and demo mode. Mock output is clearly labelled.
AI_PROVIDER=mock
# OpenAI-compatible (set AI_PROVIDER=openai or openai-compatible).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Anthropic (set AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Bring-your-own-key: when true, organisations configure their own keys in-app.
AI_ALLOW_BYO_KEY=true
# Usage limits per organisation per calendar month (token cost in USD cents).
AI_MONTHLY_COST_LIMIT_CENTS=2000
# Redaction: comma-separated regex patterns stripped from prompts before send.
AI_REDACTION_PATTERNS=

# ----------------------------------------------------------------------------
# Audit worker (separate mini-service for crawling — isolates SSRF surface)
# ----------------------------------------------------------------------------
# Worker mini-service port (internal). See docs/setup/audit-worker-setup.md.
AUDIT_WORKER_PORT=3002
# Worker <-> app shared secret for internal API auth.
AUDIT_WORKER_SECRET=changeme-generate-a-strong-random-secret
# Crawler isolation: "docker" recommended in production. "process" for dev.
CRAWLER_ISOLATION=process
# Run the crawler in an isolated environment where practical.
CRAWLER_ALLOW_PRIVATE_NETWORK=false   # MUST be false in production (SSRF).

# ----------------------------------------------------------------------------
# PDF generation
# ----------------------------------------------------------------------------
PDF_WORKER_PORT=3003
PDF_WORKER_SECRET=changeme-generate-a-strong-random-secret
# Bundled fonts (OFL). See docs/legal/ASSET_RIGHTS_REGISTER.md.
PDF_FONT_HEADING=Fraunces
PDF_FONT_BODY=Inter

# ----------------------------------------------------------------------------
# File / object storage
# ----------------------------------------------------------------------------
# "local" for dev, "s3" (S3-compatible) for production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Signed URL expiry for screenshot/recording access (seconds).
STORAGE_SIGNED_URL_EXPIRY=3600

# ----------------------------------------------------------------------------
# Realtime (Socket.io mini-service, optional)
# ----------------------------------------------------------------------------
REALTIME_PORT=3004
REALTIME_SECRET=changeme-generate-a-strong-random-secret

# ----------------------------------------------------------------------------
# Licence validation
# ----------------------------------------------------------------------------
# "mock" for dev/demo, "live" for production.
LICENCE_DRIVER=mock
# Licence server endpoint (only licence_id + deployment_fingerprint + timestamp
# are transmitted — NEVER client data).
LICENCE_SERVER_URL=https://licence.wintervell.example
LICENCE_KEY=
# Offline grace period (days). Product never deletes data when validation fails.
LICENCE_OFFLINE_GRACE_DAYS=14

# ----------------------------------------------------------------------------
# Security headers
# ----------------------------------------------------------------------------
# Comma-separated CSP sources. Configure restrictively in production.
CSP_DEFAULT_SRC='self'
CSP_IMG_SRC='self' data: blob:
CSP_CONNECT_SRC='self'
# Trusted host for NextAuth (set to your production domain).
TRUSTED_HOST=

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
# Per-IP rate limits (requests per minute).
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUDIT_CREATE=20
RATE_LIMIT_REPORT_SHARE=30

# ----------------------------------------------------------------------------
# Analytics & error reporting (optional)
# ----------------------------------------------------------------------------
ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=
ERROR_REPORTING_DSN=

# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
FEATURE_DEMO_MODE=true
FEATURE_WHITE_LABEL=true
FEATURE_PDF_EXPORT=true
FEATURE_AI_ASSIST=true

# ----------------------------------------------------------------------------
# DO NOT commit real secrets. Rotate any key that is accidentally committed.
# ----------------------------------------------------------------------------
