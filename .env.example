# WinterVell — Environment Configuration
#
# Copy this file to .env and fill in the values.
# Only placeholders are included — no real secrets.
# Not all variables are required for local development.
# Safe mock or console adapters are provided for unconfigured services.

# ─── Application ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=
ENCRYPTION_KEY=

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=
DIRECT_DATABASE_URL=

# ─── Authentication ────────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_EMAIL_FROM=
AUTH_SMTP_URL=

# ─── Worker ────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=
AUDIT_MAX_PAGES=
AUDIT_MAX_DEPTH=
AUDIT_TIMEOUT_MS=
AUDIT_MAX_RESPONSE_BYTES=

# ─── Storage ───────────────────────────────────────────────────────────────
STORAGE_DRIVER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── AI ────────────────────────────────────────────────────────────────────
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Checkout ──────────────────────────────────────────────────────────────
CHECKOUT_PROVIDER=
CHECKOUT_WEBHOOK_SECRET=
AGENCY_PRODUCT_ID=
STUDIO_PRODUCT_ID=

# ─── Email ─────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_URL=

# ─── Observability ─────────────────────────────────────────────────────────
LOG_LEVEL=
ERROR_REPORTING_DSN=

# ─── Site ──────────────────────────────────────────────────────────────────
# Site URL — used for canonical, OG images, sitemap
# For preview deployments, use the Vercel preview URL
# For production, use the confirmed production domain
NEXT_PUBLIC_SITE_URL=https://wintervell.com
